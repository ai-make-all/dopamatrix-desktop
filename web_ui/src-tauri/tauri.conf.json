{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DopaMatrix",
  "version": "1.1.0",
  "identifier": "com.dopamatrix.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DopaMatrix Studio",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["bin/backend"],
    "resources": ["bin/ffmpeg.exe", "bin/ffprobe.exe", ".env"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": "^((mailto:\\w+)|(tel:\\w+)|(https?://\\w+)|([A-Za-z]:\\\\.+)|(\\/.*)).+"
    }
  }
}
