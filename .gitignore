# ==========================================
# DopaMatrix V1.1 商业级 .gitignore 配置
# ==========================================

# ── 1. 敏感数据与环境配置 (Zero Trust) ──
.env
.env.*
# Local SQLite databases
/dopamatrix*.db
/dopamatrix*.db-*
/data/dopamatrix*.db
/data/dopamatrix*.db-*

# Local Python environment
venv_build/

# Keep the safe environment template trackable
!.env.example

# ── 2. 媒体资产与输出产物 ──
assets/matrix_pool/
output/
tests/assets/
*.mp4
*.wav
*.mp3

# ── 3. 运行日志 ──
*.log
logs/

# ── 4. Python & 虚拟环境 ──
.pytest_cache/
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.env_build/

# ── 5. PyInstaller 打包缓存 ──
build/
dist/
*.spec

# ── 6. 前端 (Vue) 与 Tauri 依赖及产物 ──
node_modules/
web_ui/node_modules/
web_ui/dist/
# Tauri 编译的庞大缓存目录
web_ui/src-tauri/target/
# 忽略打包生成的边车文件，但【绝对不能】忽略 ffmpeg.exe 和 ffprobe.exe
web_ui/src-tauri/bin/backend-*
web_ui/src-tauri/bin/backend

# ── 7. IDE 与系统文件 ──
.vscode/
.idea/
.DS_Store
Thumbs.db

# 忽略根目录下的本地物理渲染依赖
ffmpeg.exe
ffprobe.exe
draft.md